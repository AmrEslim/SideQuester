# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare files that should be handled as text
*.rs text
*.toml text
*.md text
*.html text
*.css text
*.js text
*.json text
*.yml text
*.yaml text
*.sh text eol=lf
*.ps1 text eol=crlf

# Declare files that are binary and should not be modified
*.wasm binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
